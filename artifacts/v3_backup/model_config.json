{
  "architecture": "efficientnet_b0 + Transformer",
  "backbone": "efficientnet_b0",
  "lr_scheduler": "cosine",
  "num_classes": 7,
  "label_map": {
    "nv": 0,
    "mel": 1,
    "bkl": 2,
    "bcc": 3,
    "akiec": 4,
    "vasc": 5,
    "df": 6
  },
  "image_size": 224,
  "normalization": {
    "mean": [
      0.485,
      0.456,
      0.406
    ],
    "std": [
      0.229,
      0.224,
      0.225
    ]
  },
  "batch_size": 32,
  "learning_rate": 0.0001,
  "seed": 42,
  "split_strategy": "GroupShuffleSplit by lesion_id",
  "train_sampler": "WeightedRandomSampler on train only"
}